{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
    "dev": "bun run --filter '@{{PROJECT_NAME}}/cli' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "bunx eslint . --max-warnings 0",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
